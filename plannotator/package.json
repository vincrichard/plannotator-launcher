{
  "name": "plannotator-review-proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "python3 test-durable.py && npm run test:proxy && node test-auth.mjs && node test.mjs",
    "test:auth": "node test-auth.mjs",
    "test:auth:firefox": "TEST_BROWSER=firefox node test-auth.mjs",
    "test:proxy": "node --test --test-timeout=10000 test-proxy.mjs test-route-adapter.mjs",
    "test:performance": "MEASURE_LOADING=1 node test-auth.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
